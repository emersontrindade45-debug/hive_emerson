{
  "mcpServers": {
    "vidiq": {
      "type": "http",
      "url": "https://mcp.vidiq.com/mcp"
    },
    "multi": {
      "command": "python3",
      "args": ["-m", "multi_mcp"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      },
      "cwd": "${HOME}/.local/share/hive/multi_mcp"
    }
  }
}
